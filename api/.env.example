MONGO_URL=
PORT=4101
SECRET=
# Frontend origin allowed to call this API (e.g. your Vercel deployment URL).
# Leave unset in local dev to allow any origin.
CORS_ORIGIN=
# Web push - generate with `npx web-push generate-vapid-keys`. Public key is
# also served to the frontend from GET /push-subscriptions/vapid-public-key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:
